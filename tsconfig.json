{
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"],
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",

    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",

    "types": ["jest", "node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true
  }
}